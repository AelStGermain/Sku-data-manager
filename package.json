{
  "name": "sku-data-manager",
  "version": "1.0.0",
  "description": "Smart Shelf Master Data — SKU enrichment script",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint src server.js eslint.config.js",
    "lint:fix": "eslint src server.js eslint.config.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"server.js\" \"tests/**/*.js\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"server.js\"",
    "test": "npm run check && npm run lint && node --test",
    "enrich": "node scripts/enrich-cron.js",
    "import": "node scripts/import-excel.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.50.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.4.168",
    "prettier": "^3.9.6",
    "xlsx": "^0.18.5"
  }
}
