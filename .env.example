# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Storage: relative paths are resolved from the project root.
DATA_DIR=local_data
STORAGE_CACHE_TTL_MS=5000
IMPORT_HISTORY_LIMIT=200

# HTTP / reverse proxy
TRUST_PROXY=1
CORS_ORIGINS=https://sku.example.com
JSON_BODY_LIMIT=50mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
SHUTDOWN_TIMEOUT_MS=10000
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=65000
MAX_IMPORT_RECORDS=100000

# Firebase is optional. Set false to prevent initialization and all sync attempts.
FIREBASE_ENABLED=false
# Backward-compatible switch. A value of 1 also disables Firebase.
DISABLE_FIREBASE_SYNC=1
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-key.json
FIREBASE_COLLECTION=levantamientos
FIREBASE_PAGE_SIZE=2000
FIREBASE_SYNC_INTERVAL_MS=3600000
FIREBASE_INITIAL_SINCE=2025-05-01

# External enrichment
EXTERNAL_API_URL=https://world.openfoodfacts.org/api/v2/product
OPEN_PRODUCTS_API_URL=https://world.openproductsfacts.org/api/v2/product
SOLOTODO_API_URL=https://publicapi.solotodo.com/products/
EXTERNAL_API_TIMEOUT_MS=8000
ENRICH_CONCURRENCY=5
ENRICH_TIMEOUT_MS=9000
ENRICH_DELAY_MS=120
ENRICH_LIMIT=200

# CLI importer
LOCAL_API_URL=http://localhost:3000/api/products/bulk
IMPORT_CHUNK_SIZE=5000
